do
    let modu1 = slow 6 sine
        modu2 = slow 2 sine
    d1 $ slow 4 $ n "[a, f, c]"
        # octave 3
        # legato 2
        # s "wob"
        # lpf (range (range 200 800 modu2) 1600 modu1)
        # lpq (range 0.1 0.3 modu2)
        # pan (range 0 1 modu1)
        # gain 0.8    


setcps (95/60/4)

d2 $ slow 2 $ n "2 2 ~ ~"
    # s " kick"
    # lpf 400
    # room 0.8
    # sz 0.9


d3 $ n "1*8" |> (irand 32) 
    # s "amencutup"
    # room 0.99
    # sz 0.97
    # pan (slow 4 (range 0 1 sine))
    # gain 0.7



d4 $ slow 4
    $ n "d f a c"
    # legato 2
    # s "ab2"
    # vowel "a e i f"/2
    # room 0.5
    # gain 0.5


hush