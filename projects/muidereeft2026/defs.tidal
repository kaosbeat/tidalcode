let
    midihush = do
      m1 silence
      m2 silence
      m3 silence
      m4 silence
    asciihush = do
      x1 silence
      x2 silence
      x3 silence
      x4 silence
    hush = do
      mapM_ ($ silence) [d1,d2,d3,d4,d5,d6,d7,d8,d9,d10,d11,d12,d13,d14,d15,d16]
      midihush
      asciihush