-- // gabbasmurf


setcps 0.6


do
  hush
  hydramode 5
  d5 $ fast 4 $ n "c4 c4 <cs4 cs5> c4"
    # legato "1!2 1.5 0.9"
    # amp "0.5 0.5 0.9 0.5"
    # s "acid309"
    #octave 7

d7 $ fast 0.25 $ n "f e f e"
  #legato 0.4
  # s "acid309"


do
  hydramode 4
  -- d7 silence
  d1 $ n "5*4"
    # s "[kick, midi]"
    # midichan 1

d2 $ n "1(<5 3> ,8)"
  # s "snare"
  # gain 1.2


d3 $ n "t(<3 2 7>,16,[0,1,3])"
  # s "superreese"
  # midichan 5

hydramode 8

d3 silence

d5 silence

hush

d6 $ chop 8 $ scramble 16 
  $ s "turbo"
  # gain 1.2

d7 silence

d2 $ midinote "60 59 59 [58 58]" 
  # s "op1" -- polimide


d2 $ n "1 <0 1> 1 [1 4]" # s "gab"

d2 silence


do
  hush
  d3 $ slow 1 $ n"1 1 1 1*4"
    # s" rave2"
    # speed "1 1.5"
  -- d3 silence
  d1 $ fast 2 $n "4*1"
    # s "gabba"
    # gain 1.2
  hydramode 1



do
  rects
  cam3
  hydramode 5
  d4 $ n (slow 1 
      $ segment 16 
      $ range 16 32 $ rand) 
      # s "amencutup"
    # gain 1.2
    # pan 0.5
  m2 $ n  "8*16" |> (irand 64)
    # s "midi"
    # midichan 2

do
  d1 $ s "bytebeats" <| n "2 3 6 7"
    # legato 0.5
    # gain 0.9
  -- hydramode 7


d3 $ s "kick:3!3 kick!1"
  # legato  1
  # gain 1
  # slow 4 (legato "<0.9 0.6>")
  # squiz 0.9


d1 $ (slow 2 $ segment 4 $ range 0 32 $ sine) # s "bytebeats:6"
  # legato 1
  # gain 0.9


d1 $ s "bytebeats" <| n (off 0.125 (|+ "3 ") "12 3 6 ~ 7  ~ 23 21 ")
  # legato 0.4
  # room 0.9 # sz 0.8
  # lpf (slow 16 (100 +(4000*saw)))
  # gain 0.9


d2 $ s "gabba:1!4"
  # gain 2


do
  alsocubes
  cube3
  d3 $ n " 4!3 <4 2>"
    # s "[hardkick, midi]"
    # pan 0.5
    # gain 1.2
    # midichan 1

hydramode 5




d3 $ n "2 1 1 1 "
  # s "[hardkick, midi]"
  # gain 1.2
  # room 0.6 # sz 0.8
  

do
  hush
  d2 $ s "bytebeats" <| n "12 12 15 ~ [ 2 2 8 2 2]   ~ 23 21 "
    # legato 0.8
    # distort (range 0.5 1 $ perlin)
    # pan 0.5


d4 $ struct "t(<5 7>,<8 16>)" $ note (off "0.125" (|+ 12) "1 3 3 1 2 3 8 8")
  # speed "1 2 3"
  # s "print3d"
  # pan 0.5
  # legato 0.8
  # squiz 2
  # size 0.8
  # shape 0.3


do
  lines
  hydramode 8
  let pat1  = " 0 <0 3 4> [2 1] [2 3]"
  d3 $ off 0.25 (# vowel "<a e i>")
    $ juxBy 0.4 rev
    $every 2 (rot "<2 5 3 5>")
    $ n pat1
    # sound "feel"
    # speed 1.8
  m1 $ n pat1
    # s "midi"
    #midichan 4

d1 $ slow "1" $ n "1 1 1 1"  # s "hardkick" # speed "1 2 <2 4> 4"
  # pan "0.125 0.375 0.625 0.8751"
  # gain 1


d2 $ jux rev $ slow "1" $ n "2 1 3 1"  # s "invaders:1" <| "2 1 3 4"
  # shape "<0 0.4 2 0.7>"
  # gain "0.8"
  # lpf 6400



d1 $ n "4 <5 5 4> <5 4> 4 "  # s "kick"
  # room 0.3
  # distort 0.1
  # gain "<0.9 0.8>"
  # pan 0.5
  # channel "[0 1 2 3, 0]"


do
  d5 $ slow 4 $ n "42 35 37 40" 
    # s "[midi, rash]"
    # midichan 1
  hydramode 4
  cube1

d5  $ slow 4 $ n "[42 40 42 . 40*2] 37 35 _ 37 _ 40 _"
  # s "[midi, rash]"
  # midichan 1
  # pan 0.5
  # squiz 3

cam2


cube4

rects

d6 $ slow 4 $  n (off 0.125 (|+ 12) "42 35 37 40 35 37 _ 40 " ) # s "made:5"
  # speed "0.5 0.6 0.4 0.4"
  # room 0.8 #sz 0.6
  # gain 0.8
  # pan 0.5

d5 $ jux' [rev, (# speed "[2 1 6 4]")] $ slow 4 $ n (off "<0.125 0.25>" (|+ 12) "~ [f4 g4] e5 a4")
  # s "plaits"
  # legato 4
  # pF "timbre" (slow 16 (range 0 0.3 (sine)))
  # pF "harm" 4
  # pI "engine" 3
  # pF "morph" "<0.9 0 0.4 0.1>"
  # vowel "a e i o"
  # room 0.6 #sz 0.5
  # gain 0.9

hush

do
  let wl = 0
  d2 $ s "kick:5(<2 6 5 7>,8)"
    # waveloss wl
    # crush  "<16 1>"
    # scram 0
    # gain 0.7
  d3 $ s "kick:2(5,8)"
    # waveloss wl
    # room 0.6 # sz 0.1
    #gain 0.6
  hydramode 9
